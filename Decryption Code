def Decryption(char, shift1, shift2):
    if char.islower():
       for v in range(26):
        original_char = chr(ord('a')+v)
        if cypher(original_char, shift1, shift2)==char:
          return original_char
    elif char.isupper():
      for v in range(26):
        original_char = chr(ord('A')+v)
        if cypher(original_char, shift1, shift2)==char:
          return original_char
    elif char.isdigit():
      for v in range(10):
        original_digit=str(v)
        if cypher(original_digit, shift1, shift2)==char:
          return original_digit
    return char
        

def decrypt_text():
    input_file = "encrypted_text.txt"
    with open(input_file, "r") as file:
        decryption_key = file.readline().strip().split(', ')
        decryption_shift1 = int(decryption_key[0])
        decryption_shift2 = int(decryption_key[1])
        content = file.read()

    Decrypted_chars = []
    for char in content:
        Decrypted_chars.append(Decryption(char, decryption_shift1, decryption_shift2))
    Decrypted = str("".join(Decrypted_chars))

    output_file2 = "decrypted_text.txt"
    with open(output_file2, "w") as file:
        file.write(Decrypted)
    print(f"Decryption Completed! Decrypted text saved to {output_file2}")

